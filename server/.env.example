PORT=3001
OPENAI_API_KEY=sk-your-openai-api-key-here
# Production chat model (Chat Completions). Verify IDs in OpenAI docs / MCP:
#   codex mcp add openaiDeveloperDocs --url https://developers.openai.com/mcp
OPENAI_CHAT_MODEL=gpt-4o
# Optional: after a nutrition fine-tune completes, set to the ft:... model id.
# OPENAI_MEAL_MODEL=

# Fine-tuning admin API (POST /api/finetune/*). Header: X-Finetune-Secret
# Use the same value for VITACARE_FINETUNE_SECRET in vitacare-mcp (Cursor MCP env).
FINETUNE_ADMIN_SECRET=change-me-long-random
OPENAI_FINETUNE_BASE_MODEL=gpt-4o-mini
